# =============================================================================
# Ascentful Environment Configuration
# =============================================================================
#
# SECURITY NOTICE: See docs/SECRETS_MANAGEMENT.md for rotation policies.
#
# Categories:
#   [HIGH]   - Rotate every 90 days, restricted access
#   [MEDIUM] - Rotate every 180 days, engineering team access
#   [LOW]    - Rotate annually, broader access
#
# Never commit actual values to git. This file contains placeholders only.
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================

# [LOW] Application URL - public configuration
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# CLERK AUTHENTICATION
# Obtain from: Clerk Dashboard -> API Keys
# =============================================================================

# [LOW] Public key - safe to expose in browser
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# [HIGH] Secret key - server-side only, never expose
# Rotation: 90 days or on personnel change
CLERK_SECRET_KEY=

# [LOW] JWT issuer domain - copy from Clerk Dashboard JWT template
CLERK_JWT_ISSUER_DOMAIN=

# [MEDIUM] Webhook secret - for validating Clerk webhooks
# Rotation: 180 days or if webhook URL changes
CLERK_WEBHOOK_SECRET=

# [LOW] Auth route configuration - public URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# =============================================================================
# CONVEX DATABASE
# =============================================================================

# [LOW] Convex deployment URL - public configuration
# Used by client-side React hooks (useQuery, useMutation)
NEXT_PUBLIC_CONVEX_URL=

# [LOW] Same as above, for server-side API routes
CONVEX_URL=

# [HIGH] Internal service token for trusted server-to-server Convex calls (e.g., webhooks)
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
CONVEX_INTERNAL_SERVICE_TOKEN=

# [HIGH] Deploy keys for CI/CD and manual deployments
# Get from: Convex Dashboard -> [deployment] -> Settings -> Deploy Key
# IMPORTANT: Use the correct key for each environment to avoid cross-deployment issues
CONVEX_DEPLOY_KEY_DEV=
CONVEX_DEPLOY_KEY_PROD=

# =============================================================================
# OPENAI / AI SERVICES
# =============================================================================

# [HIGH] OpenAI API key - handles student/advisor data
# Rotation: 90 days or on personnel change
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# =============================================================================
# STRIPE PAYMENTS
# =============================================================================

# [HIGH] Stripe secret key - full account access
# Rotation: 90 days or on personnel change
# Get from: Stripe Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY=

# [LOW] Stripe publishable key - safe for browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# [MEDIUM] Webhook secret - for validating Stripe webhooks
# Rotation: 180 days or if webhook endpoint changes
STRIPE_WEBHOOK_SECRET=

# [LOW] Payment links - public checkout URLs
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_MONTHLY=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_ANNUAL=

# [LOW] Price IDs for dynamic UI display (optional)
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# =============================================================================
# EMAIL SERVICES
# =============================================================================

# [HIGH] Mailgun API key - sends system emails (invites, resets, etc.)
# Rotation: 90 days or on personnel change
# Get from: https://app.mailgun.com/settings/api_security
MAILGUN_SENDING_API_KEY=

# [HIGH] SendGrid API key (optional fallback)
# Rotation: 90 days or on personnel change
# SENDGRID_API_KEY=

# =============================================================================
# EMAIL AUTO UPDATES (GMAIL + OUTLOOK)
# =============================================================================
#
# SECURITY: These credentials enable read-only email metadata scanning when users opt in.
# - Never log tokens or email content.
# - Use least-privilege scopes (metadata-only by default).
#

# [HIGH] Encryption key for OAuth refresh tokens stored in Convex (base64-encoded 32 bytes)
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
EMAIL_INTEGRATION_ENCRYPTION_KEY=

# [HIGH] HMAC secret for OAuth state signing (any long random string)
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
EMAIL_OAUTH_STATE_SECRET=

# [HIGH] Google OAuth (Gmail)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: Pub/Sub topic for Gmail push notifications (enables push; otherwise polling fallback)
GMAIL_PUBSUB_TOPIC=

# [MEDIUM] Gmail webhook verification token (configure as query param `?token=...` on Pub/Sub push endpoint URL)
GMAIL_PUBSUB_VERIFICATION_TOKEN=

# [HIGH] Microsoft OAuth (Outlook / Microsoft 365)
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Optional: tenant for Microsoft OAuth (default: common)
MICROSOFT_OAUTH_TENANT=common

# Optional: Enhanced-mode AI extractor (uses OpenAI on subject/from + limited snippet only)
# Defaults: model=gpt-4o-mini, max calls per scan=5
EMAIL_AUTO_UPDATES_AI_MODEL=gpt-4o-mini
EMAIL_AUTO_UPDATES_AI_MAX_CALLS=5

# =============================================================================
# PUSH NOTIFICATIONS (Web Push / VAPID)
# =============================================================================
#
# Generate keys: npx web-push generate-vapid-keys
# Documentation: https://developer.mozilla.org/en-US/docs/Web/API/Push_API
#

# [LOW] VAPID public key - safe to expose in browser
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# [HIGH] VAPID private key - server-side only, never expose
# Rotation: 90 days or if compromised
VAPID_PRIVATE_KEY=

# [LOW] VAPID email - contact email for push service
VAPID_EMAIL=mailto:support@example.com

# =============================================================================
# CHROME EXTENSION
# =============================================================================

# [HIGH] Secret for signing extension auth state tokens (CSRF protection)
# Generate: `openssl rand -hex 32`
# Rotation: 90 days or on personnel change
EXTENSION_STATE_SECRET=

# [LOW] Extension origins for CORS restriction (defense in depth)
# Format: chrome-extension://[extension-id] or moz-extension://[uuid]
# Get from: chrome://extensions (enable Developer mode, copy extension ID)
# Leave empty in development to allow all origins (wildcard)
CHROME_EXTENSION_ORIGIN=
FIREFOX_EXTENSION_ORIGIN=

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# [LOW] Feature toggles - public configuration
# Note: NEXT_PUBLIC_* vars require rebuild/redeploy to take effect
NEXT_PUBLIC_ENABLE_STUDENT_ORG_BADGE=false
